#cloud-config
# This control-plane-only cloud-init fragment prepares the first control plane
# to act as the Linux NAT gateway for private-only workers. Hetzner already
# brings up both NICs, so this template only enables IPv4 forwarding, installs
# persistent iptables support, and installs a script that enables IPv4
# forwarding and adds MASQUERADE/FORWARD rules between the private NIC and the
# default public NIC.
packages:
  - iptables-persistent
  - netfilter-persistent

write_files:
  - path: /usr/local/sbin/configure-private-egress-nat.sh
    permissions: "0755"
    content: |
      ${indent(6, replace(file("${module_path}/configure-private-egress-nat.sh"), "__PRIVATE_NETWORK_CIDR__", private_network_cidr))}

runcmd:
  - /usr/local/sbin/configure-private-egress-nat.sh